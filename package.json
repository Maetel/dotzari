{
  "name": "dotzari-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm --filter @dotzari/design-system build && pnpm --filter @dotzari/design-system-svelte build && pnpm --filter @dotzari/design-system-demo build",
    "check": "pnpm -r check",
    "dev": "pnpm --filter @dotzari/design-system-demo dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
