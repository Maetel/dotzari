{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmitOnError": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@dotzari/design-system": ["packages/design-system/src/index.ts"],
      "@dotzari/design-system/base.css": ["packages/design-system/src/base.css"],
      "@dotzari/design-system/tokens.css": ["packages/design-system/src/tokens.css"],
      "@dotzari/design-system-svelte": ["packages/design-system-svelte/src/lib/index.ts"]
    },
    "strict": true,
    "target": "ES2022"
  }
}
